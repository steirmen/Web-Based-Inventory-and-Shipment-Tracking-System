// Prisma schema — https://pris.ly/d/prisma-schema
//
// Domain model for the multi-tenant business operations platform.
// Design notes, delete strategy, indexes, and CHECK constraints are documented
// in docs/database-design.md. CHECK constraints live in the migration SQL
// because Prisma's schema language cannot express them.
//
// Conventions
// - Primary keys: UUIDv7 generated by Prisma Client (time-ordered → index-friendly).
// - Tables/columns: snake_case in PostgreSQL via @@map / @map.
// - Tenant-owned rows carry `organization_id`. References between tenant-owned
//   rows use COMPOSITE foreign keys (organization_id, <x>_id) → <x>(organization_id, id),
//   so a row can never point at another organization's data.
// - Money: NUMERIC (Decimal), never floating point. Quantities: INTEGER units.
// - Timestamps: timestamptz(3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  STAFF

  @@map("member_role")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT

  @@map("stock_movement_type")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

/// ISO 4217 codes (Phase 10.1). Mirrors CURRENCIES in packages/shared/src/currency.ts.
enum Currency {
  TRY
  EUR
  USD

  @@map("currency")
}

// -----------------------------------------------------------------------------
// Identity & tenancy
// -----------------------------------------------------------------------------

/// A person who can sign in. Global (not tenant-owned); joins organizations via OrganizationMember.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(200)
  /// Globally unique. Must be stored normalized (trimmed, lowercase) — enforced by a CHECK constraint.
  email        String   @unique @db.VarChar(320)
  /// Password hash (never plaintext). Nullable: users may exist before a credential is set (invites, seed data).
  passwordHash String?  @map("password_hash") @db.Text
  /// Interface language ('en' | 'tr', CHECK constraint); null until the user chooses one.
  language     String?  @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        OrganizationMember[]
  sessions           Session[]
  sentInvitations    OrganizationInvitation[]
  stockMovements     StockMovement[]
  activityLogs       ActivityLog[]
  appearance         UserAppearance?
  appearanceProfiles AppearanceProfile[]

  @@map("users")
}

/// A signed-in browser session. The raw token lives only in the HttpOnly cookie;
/// the database stores its SHA-256 hash. See docs/authentication.md.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Lowercase hex SHA-256 of the session token (format enforced by a CHECK constraint).
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// Absolute expiry; the session is invalid afterwards even if the cookie still exists.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last authenticated request (updated at most every few minutes).
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Set on logout; revoked sessions are rejected.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user's sessions (e.g. "sign out everywhere"); also backs the cascade from users.
  @@index([userId])
  /// Cleanup of expired sessions.
  @@index([expiresAt])
  @@map("sessions")
}

/// A tenant: one business/company. Owns all business data.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  /// URL-safe identifier, globally unique (lowercase letters, digits, single hyphens).
  slug      String   @unique @db.VarChar(63)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members             OrganizationMember[]
  invitations         OrganizationInvitation[]
  categories          Category[]
  products            Product[]
  warehouses          Warehouse[]
  inventory           Inventory[]
  stockMovements      StockMovement[]
  customers           Customer[]
  orders              Order[]
  orderItems          OrderItem[]
  orderNumberSequence OrderNumberSequence?
  activityLogs        ActivityLog[]

  @@map("organizations")
}

/// A user's membership (and role) in an organization. The role is data only; RBAC is enforced in a later phase.
model OrganizationMember {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(STAFF)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  /// "Which organizations does this user belong to?"
  @@index([userId])
  // A partial unique index "organization_members_one_owner_per_organization"
  // (at most one OWNER per organization) is created in migration SQL, because
  // Prisma's schema language cannot express partial indexes.
  @@map("organization_members")
}

/// A pending offer to join an organization. The raw token exists only in the
/// invite link; the database stores its SHA-256 hash. See docs/organizations-rbac.md.
model OrganizationInvitation {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  /// Normalized (trimmed, lowercase) — enforced by a CHECK constraint.
  invitedEmail    String     @map("invited_email") @db.VarChar(320)
  /// ADMIN or STAFF (OWNER is rejected by a CHECK constraint).
  role            MemberRole
  /// Lowercase hex SHA-256 of the invitation token.
  tokenHash       String     @unique @map("token_hash") @db.Char(64)
  /// Always set on creation; becomes null only if the inviting user is deleted (history is kept).
  invitedByUserId String?    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Accepted and revoked are mutually exclusive (CHECK constraint).
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?  @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  /// Invitation list of an organization (newest first); also finds pending invites per email.
  @@index([organizationId, createdAt(sort: Desc)])
  /// Pending-invitation lookup for one email address.
  @@index([organizationId, invitedEmail])
  /// Cleanup of expired invitations.
  @@index([expiresAt])
  /// Backs the inviter foreign key (ON DELETE SET NULL).
  @@index([invitedByUserId])
  @@map("organization_invitations")
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  /// Target of tenant-safe composite foreign keys.
  @@unique([organizationId, id])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String        @db.VarChar(200)
  /// Stock keeping unit, unique per organization (case-sensitive).
  sku            String        @db.VarChar(64)
  description    String?       @db.Text
  /// Selling price per unit.
  price          Decimal       @db.Decimal(12, 2)
  /// Purchase cost per unit; null when unknown.
  cost           Decimal?      @db.Decimal(12, 2)
  /// Currency of price and cost. Existing products were migrated to TRY (docs/currency.md).
  currency       Currency      @default(TRY)
  /// Reorder threshold in units (low-stock alerts).
  minimumStock   Int           @default(0) @map("minimum_stock")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       Category?       @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  inventory      Inventory[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, id])
  /// Filter by category; also backs the category foreign key.
  @@index([organizationId, categoryId])
  /// Catalog lists filtered by status (e.g. active products only).
  @@index([organizationId, status])
  /// Default product list order (newest first) with pagination.
  @@index([organizationId, createdAt(sort: Desc)])
  /// Product list sorted by name.
  @@index([organizationId, name])
  @@map("products")
}

// -----------------------------------------------------------------------------
// Warehousing & stock
// -----------------------------------------------------------------------------

model Warehouse {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  /// Short identifier, unique per organization (e.g. "MAIN").
  code           String   @db.VarChar(32)
  address        String?  @db.Text
  /// Retire warehouses instead of deleting them; history references them.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventory      Inventory[]
  stockMovements StockMovement[]
  orders         Order[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("warehouses")
}

/// Current on-hand quantity of one product in one warehouse. Derived from, and kept in step with, StockMovement.
model Inventory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  /// One row per product per warehouse; also serves "all stock in a warehouse".
  @@unique([warehouseId, productId])
  /// "Stock of a product across all warehouses"; also backs the product foreign key.
  @@index([organizationId, productId])
  @@map("inventory")
}

/// Append-only ledger of every inventory change. Rows are never updated or deleted.
model StockMovement {
  id              String            @id @default(uuid(7)) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  /// Who caused the change; null for system-generated movements or deleted users.
  actorUserId     String?           @map("actor_user_id") @db.Uuid
  movementType    StockMovementType @map("movement_type")
  /// Signed change in units: > 0 increases stock, < 0 decreases it. Never 0.
  quantityDelta   Int               @map("quantity_delta")
  quantityBefore  Int               @map("quantity_before")
  quantityAfter   Int               @map("quantity_after")
  reason          String?           @db.Text
  /// Polymorphic link to the business action that caused the movement (e.g. "ORDER" + order id).
  referenceType   String?           @map("reference_type") @db.VarChar(50)
  referenceId     String?           @map("reference_id") @db.Uuid
  /// Shared by the TRANSFER_OUT and TRANSFER_IN rows of one warehouse transfer.
  transferGroupId String?           @map("transfer_group_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Product stock history (newest first).
  @@index([organizationId, productId, createdAt(sort: Desc)])
  /// Warehouse stock history (newest first).
  @@index([organizationId, warehouseId, createdAt(sort: Desc)])
  /// Organization-wide movement feed.
  @@index([organizationId, createdAt(sort: Desc)])
  /// "Which movements did order X cause?"
  @@index([organizationId, referenceType, referenceId])
  /// Correlate both sides of a transfer.
  @@index([transferGroupId])
  /// Backs the actor foreign key (ON DELETE SET NULL).
  @@index([actorUserId])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// Sales
// -----------------------------------------------------------------------------

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  /// Not unique: several contacts may share an address, and uniqueness is not a domain rule.
  email          String?  @db.VarChar(320)
  phone          String?  @db.VarChar(50)
  companyName    String?  @map("company_name") @db.VarChar(200)
  address        String?  @db.Text
  notes          String?  @db.Text
  /// Retire customers instead of deleting them; orders reference them.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders       Order[]

  @@unique([organizationId, id])
  /// Customer lists sorted/searched by name.
  @@index([organizationId, name])
  /// Look up a customer by email within the organization.
  @@index([organizationId, email])
  @@map("customers")
}

model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  /// Human-facing identifier, unique per organization (e.g. "SO-1001").
  orderNumber    String      @map("order_number") @db.VarChar(50)
  /// Optional: e.g. walk-in sales or drafts without a customer yet.
  customerId     String?     @map("customer_id") @db.Uuid
  /// Warehouse the order is fulfilled from.
  warehouseId    String      @map("warehouse_id") @db.Uuid
  status         OrderStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  /// The currency of every line (trigger-enforced); null while the order has no lines.
  currency       Currency?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  items        OrderItem[]

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, id])
  /// Order lists filtered by status, newest first.
  @@index([organizationId, status, createdAt(sort: Desc)])
  /// Order lists, newest first.
  @@index([organizationId, createdAt(sort: Desc)])
  /// A customer's orders; also backs the customer foreign key.
  @@index([organizationId, customerId])
  /// Backs the warehouse foreign key.
  @@index([organizationId, warehouseId])
  @@map("orders")
}

/// A line of an order. Snapshots the product's name, SKU, and price at order time.
model OrderItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  /// Denormalized from the order so the product reference can be tenant-checked by a composite foreign key.
  organizationId      String   @map("organization_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(200)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(64)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Snapshot of the product currency; always equals the order's currency (trigger).
  currency            Currency
  quantity            Int
  lineTotal           Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  /// One line per product per order (Phase 7A).
  @@unique([orderId, productId])
  /// Items of an order; also backs the order foreign key.
  @@index([organizationId, orderId])
  /// Sales history of a product; also backs the product foreign key.
  @@index([organizationId, productId])
  @@map("order_items")
}

/// Per-organization order number counter (Phase 7A). The next number is taken with one
/// atomic upsert inside the order-creating transaction, so concurrent creates never collide.
model OrderNumberSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  /// Numeric part of the last issued order number ("SO-1005" → 1005).
  lastNumber     Int      @map("last_number")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("order_number_sequences")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

/// Append-only record of notable actions within an organization.
model ActivityLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Null for system events or when the user has been deleted.
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// Machine-readable action, e.g. "PRODUCT_CREATED".
  action         String   @db.VarChar(100)
  /// Kind of entity affected, e.g. "Product".
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  /// Free-form event details (JSONB).
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Organization activity feed, newest first.
  @@index([organizationId, createdAt(sort: Desc)])
  /// History of a single entity, newest first.
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  /// Backs the actor foreign key (ON DELETE SET NULL).
  @@index([actorUserId])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
// Personalization (Phase 7B) — user-level, presentation only, never per organization.
// Allowed values are CHECK constraints in the migration, mirroring @app/shared (appearance.ts).
// -----------------------------------------------------------------------------

/// The user's current appearance. No row = the defaults (DEFAULT_APPEARANCE).
model UserAppearance {
  userId             String   @id @map("user_id") @db.Uuid
  mode               String   @db.VarChar(16)
  theme              String   @db.VarChar(32)
  /// "#rrggbb", lower-case.
  customAccent       String   @map("custom_accent") @db.VarChar(7)
  customTone         String   @map("custom_tone") @db.VarChar(16)
  backgroundEffect   String   @map("background_effect") @db.VarChar(32)
  animationIntensity String   @map("animation_intensity") @db.VarChar(16)
  density            String   @db.VarChar(16)
  radius             String   @db.VarChar(16)
  fontScale          String   @map("font_scale") @db.VarChar(16)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Personal preferences go away with the user.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_appearances")
}

/// A named, saved appearance of one user ("Night work", "Office", …).
model AppearanceProfile {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  /// Unique per user, case-insensitively (expression index in the migration).
  name               String   @db.VarChar(60)
  mode               String   @db.VarChar(16)
  theme              String   @db.VarChar(32)
  customAccent       String   @map("custom_accent") @db.VarChar(7)
  customTone         String   @map("custom_tone") @db.VarChar(16)
  backgroundEffect   String   @map("background_effect") @db.VarChar(32)
  animationIntensity String   @map("animation_intensity") @db.VarChar(16)
  density            String   @db.VarChar(16)
  radius             String   @db.VarChar(16)
  fontScale          String   @map("font_scale") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user's profiles in creation order; also backs the user foreign key.
  @@index([userId, createdAt])
  @@map("appearance_profiles")
}
