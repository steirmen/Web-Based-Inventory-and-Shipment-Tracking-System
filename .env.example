# -----------------------------------------------------------------------------
# Local development environment
#
# Copy this file to `.env` in the repository root and adjust the values:
#   cp .env.example .env
#
# The API (NestJS + Prisma) and the web app (Vite) both read this single file.
# Never commit `.env` — it is git-ignored.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# --- API (apps/api) ----------------------------------------------------------
# Port the NestJS API listens on.
API_PORT=3000

# Comma-separated list of browser origins allowed to call the API (CORS) and to
# send state-changing requests (CSRF check). Exact origins: scheme://host[:port],
# no path or trailing slash. Must include the Vite dev server origin; https only
# in production.
API_CORS_ORIGINS=http://localhost:5173

# Reverse proxies whose X-Forwarded-For the API trusts for the client IP (rate
# limits). false = none (direct connections: the default, and correct locally);
# or a hop count such as 1; or proxy IPs/CIDR ranges, e.g. loopback,10.0.0.0/8.
# "true" (trust any proxy) is refused: clients could then spoof their IP.
API_TRUST_PROXY=false

# --- Authentication (apps/api) -------------------------------------------------
# Absolute lifetime of a sign-in session, in days (1-90). After this the user
# must sign in again, even if the browser still has the cookie.
AUTH_SESSION_TTL_DAYS=7

# Name of the HttpOnly session cookie. Keep it neutral (no product branding).
AUTH_COOKIE_NAME=app_session

# Send the session cookie over HTTPS only. Use false for local HTTP development.
# The API refuses to start with NODE_ENV=production unless this is true.
AUTH_COOKIE_SECURE=false

# --- Organizations (apps/api) --------------------------------------------------
# Lifetime of workspace invitation links, in days (1-30).
INVITATION_TTL_DAYS=7

# Public URL of the web app, used to build invitation links (no trailing slash).
WEB_APP_URL=http://localhost:5173

# --- PostgreSQL (local Windows installation) ---------------------------------
# The API and Prisma build the connection string from these values, so the
# password may contain special characters without manual URL-encoding.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_development
DB_USER=postgres
# Required (non-empty) when NODE_ENV=production.
DB_PASSWORD=change-me

# Database used by the database integration tests (`npm run test:db`), on the
# same server and credentials as above. It is created automatically if missing,
# migrated with `prisma migrate deploy`, and its tables are EMPTIED before every
# test — never point it at real data. Must end in "_test" and differ from DB_NAME.
DB_TEST_NAME=app_test

# --- Web (apps/web) ----------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to browser code.
# Base URL of the API, as reachable from the browser.
VITE_API_BASE_URL=http://localhost:3000
