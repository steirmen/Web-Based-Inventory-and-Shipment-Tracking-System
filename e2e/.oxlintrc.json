{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["test-results", "playwright-report", ".auth"]
}
